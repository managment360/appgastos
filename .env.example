# Conexión a Supabase (Postgres). Copiá este archivo a .env.local y completá.
#
# DATABASE_URL  -> "Transaction pooler" de Supabase (puerto 6543). La usa la app.
#                 Importante: el pooler de transacción NO admite prepared statements
#                 (por eso el driver usa prepare:false).
# DIRECT_URL    -> "Session pooler" de Supabase (puerto 5432). La usan las migraciones.
#
# Las dos se obtienen en: Supabase -> Project Settings -> Database -> Connection string
# Reemplazá [YOUR-PASSWORD] por la contraseña de tu base.

DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# CRON_SECRET (opcional) -> protege el endpoint /api/ping de keep-alive.
#   - Si lo seteás en Vercel, el cron interno lo manda solo (Authorization: Bearer).
#   - Un pinger externo (UptimeRobot / cron-job.org) lo pasa como ?token=<secret>.
#   - Si lo dejás vacío, /api/ping queda abierto (es solo un SELECT 1, sin riesgo).
# CRON_SECRET="una-cadena-larga-y-aleatoria"
